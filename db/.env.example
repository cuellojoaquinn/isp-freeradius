# Copiar a db/.env y completar. El .env NO se sube al repo.

# Superusuario (solo se usa desde dentro del contenedor)
POSTGRES_PASSWORD=cambiar-password-admin

# Tienen que coincidir con DB_RADIUS_PASSWORD de freeradius/.env
# y con la contraseña que use Grafana.
RADIUS_DB_PASSWORD=cambiar-password-radius
GRAFANA_DB_PASSWORD=cambiar-password-grafana
